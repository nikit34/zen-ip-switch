#!/usr/bin/env bash
set -euo pipefail

OPENCODE_APP_BIN="${ZEN_OPENCODE_APP_BIN:-/Applications/OpenCode.app/Contents/MacOS/OpenCode}"
OPENCODE_PID_PAT="opencode-cli serve --service"
OC_DB="${ZEN_OC_DB:-$HOME/.local/share/opencode/opencode.db}"
STATE_DIR="${ZEN_STATE_DIR:-$HOME/.local/share/zen-ip-switch}"
DB="$STATE_DIR/metrics.db"
DAEMON_PID="$STATE_DIR/daemon.pid"
DAEMON_LOG="$STATE_DIR/daemon.log"
APP_QUIT_WAIT="${ZEN_APP_QUIT_WAIT:-15}"
NET_IFACE="${ZEN_NET_IFACE:-}"
ZEN_PROXY_SCRIPT="${ZEN_PROXY_SCRIPT:-/Users/permi/zen-ip-switch/zen-proxy.js}"
ZEN_PROXY_PORT="${ZEN_PROXY_PORT:-9999}"
ZEN_PROXY_URL="http://127.0.0.1:${ZEN_PROXY_PORT}"
ZEN_PROXY_PID="$STATE_DIR/zen-proxy.pid"
ZEN_PROXY_LOG="$STATE_DIR/zen-proxy.log"
NODE_BIN="${ZEN_NODE_BIN:-/opt/homebrew/bin/node}"

POLL_SECS="${ZEN_POLL_SECS:-60}"
MIN_INTERVAL_SECS="${ZEN_MIN_INTERVAL_SECS:-600}"
MAX_PER_DAY="${ZEN_MAX_PER_DAY:-8}"

mkdir -p "$STATE_DIR"

step() { printf "\n\033[1;34m== %s\033[0m\n" "$*"; }
ok()   { printf "\033[1;32mOK\033[0m  %s\n" "$*"; }
warn() { printf "\033[1;33m!!\033[0m  %s\n" "$*"; }
die()  { printf "\033[1;31mXX\033[0m  %s\n" "$*" >&2; exit 1; }

db_init() {
  sqlite3 "$DB" <<SQL
CREATE TABLE IF NOT EXISTS rotations (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  ts INTEGER NOT NULL, reason TEXT
);
CREATE INDEX IF NOT EXISTS rotations_ts ON rotations(ts);
SQL
}

log_rotation() { sqlite3 "$DB" "INSERT INTO rotations(ts,reason) VALUES ($(date +%s),'${1//\'/\'\'}');"; }

app_running() { pgrep -f "$OPENCODE_APP_BIN" >/dev/null; }

app_quit_wait() {
  if app_running; then
    osascript -e 'tell application "OpenCode" to quit' 2>/dev/null || true
    local waited=0
    while (( waited < APP_QUIT_WAIT )); do
      sleep 1; waited=$((waited+1))
      app_running || break
    done
    app_running && { warn "OpenCode.app не закрылся за ${APP_QUIT_WAIT} сек"; return 1; }
  fi
  pgrep -f "$OPENCODE_PID_PAT" 2>/dev/null | xargs -r kill 2>/dev/null || true
  return 0
}

app_launch_direct() { open -a OpenCode; }
app_launch_proxied() {
  open -a OpenCode \
    --env "ALL_PROXY=$ZEN_PROXY_URL" \
    --env "HTTPS_PROXY=$ZEN_PROXY_URL" \
    --env "HTTP_PROXY=$ZEN_PROXY_URL"
}

detect_iface() {
  if [[ -n "$NET_IFACE" ]]; then echo "$NET_IFACE"; return; fi
  route -n get -inet default 2>/dev/null | awk '/interface:/ {print $2; exit}'
}

ipv6_prefix() {
  local iface="$1"
  ifconfig "$iface" 2>/dev/null \
    | awk '/inet6 2[0-9a-f]/{for(i=1;i<=NF;i++) if($i=="inet6") print $(i+1)}' \
    | awk -F: 'NF>=4 {printf "%s:%s:%s:%s\n",$1,$2,$3,$4; exit}'
}

ipv6_wifi_on() {
  networksetup -getinfo "Wi-Fi" 2>/dev/null | grep -qE "^IPv6: (Automatic|Manual|LinkLocal)" \
    || sudo -n networksetup -setv6automatic "Wi-Fi" 2>/dev/null
}

app_last_429_ts() {
  [[ -f "$OC_DB" ]] || { echo 0; return; }
  sqlite3 "$OC_DB" "SELECT COALESCE(MAX(time_updated),0)/1000 FROM session_message WHERE json_extract(data,'$.error.status')=429 AND json_extract(data,'$.model.providerID')='opencode';" 2>/dev/null || echo 0
}

last_rotation_ts() {
  sqlite3 "$DB" "SELECT COALESCE(MAX(ts),0) FROM rotations;" 2>/dev/null || echo 0
}

rotations_today() {
  local day_start; day_start=$(date -v0H -v0M -v0S +%s)
  sqlite3 "$DB" "SELECT COUNT(*) FROM rotations WHERE ts >= $day_start;" 2>/dev/null || echo 0
}

sidecar_proxy_env() {
  local pid; pid=$(pgrep -f "$OPENCODE_PID_PAT" 2>/dev/null | head -1 || true)
  [[ -z "$pid" ]] && { echo ""; return; }
  ps eww -p "$pid" 2>/dev/null | tr ' ' '\n' | grep -E "^ALL_PROXY=" | head -1 | tr -d '\n'
}

sidecar_proxied_to_zen() {
  [[ "$(sidecar_proxy_env)" == "ALL_PROXY=$ZEN_PROXY_URL" ]]
}

zen_proxy_running() {
  [[ -f "$ZEN_PROXY_PID" ]] && kill -0 "$(cat "$ZEN_PROXY_PID")" 2>/dev/null
}

start_zen_proxy() {
  zen_proxy_running && return 0
  local iface prefix
  iface=$(detect_iface)
  [[ -z "$iface" ]] && { warn "нет default route interface"; return 1; }
  prefix=$(ipv6_prefix "$iface")
  [[ -z "$prefix" ]] && { warn "нет IPv6 /64 на $iface, включи IPv6: sudo networksetup -setv6automatic Wi-Fi"; return 1; }
  [[ -x "$NODE_BIN" ]] || { warn "нет node в $NODE_BIN"; return 1; }
  [[ -f "$ZEN_PROXY_SCRIPT" ]] || { warn "нет $ZEN_PROXY_SCRIPT"; return 1; }
  ZEN_IPV6_PREFIX="$prefix" ZEN_IFACE="$iface" ZEN_PROXY_PORT="$ZEN_PROXY_PORT" \
    nohup "$NODE_BIN" "$ZEN_PROXY_SCRIPT" >>"$ZEN_PROXY_LOG" 2>&1 &
  echo $! > "$ZEN_PROXY_PID"
  disown || true
  sleep 3
  zen_proxy_running
}

stop_zen_proxy() {
  [[ -f "$ZEN_PROXY_PID" ]] || return 0
  local pid; pid=$(cat "$ZEN_PROXY_PID")
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    sleep 2
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$ZEN_PROXY_PID"
}

signal_rotate() {
  zen_proxy_running || return 1
  kill -USR1 "$(cat "$ZEN_PROXY_PID")" 2>/dev/null || return 1
  log_rotation "sigusr1"
}

restart_app_if_stale_429() {
  app_running || return 0
  local a429 lrot
  a429=$(app_last_429_ts)
  lrot=$(last_rotation_ts)
  (( a429 > lrot )) || return 0
  app_quit_wait && app_launch_proxied
}

do_daemon_loop() {
  db_init
  trap 'rm -f "$DAEMON_PID"' EXIT INT TERM
  set +e
  while true; do
    local ts a429 lrot now gap today
    ts=$(date -u +%FT%TZ)
    a429=$(app_last_429_ts); lrot=$(last_rotation_ts); now=$(date +%s)
    if (( a429 > lrot )); then
      gap=$(( now - lrot ))
      today=$(rotations_today)
      if (( gap < MIN_INTERVAL_SECS )); then
        echo "$ts свежий 429 но слишком рано ($gap < ${MIN_INTERVAL_SECS}s), жду"
      elif (( today >= MAX_PER_DAY )); then
        echo "$ts свежий 429 но daily cap ($today/$MAX_PER_DAY), жду до завтра"
      else
        echo "$ts свежий 429 ($(date -r "$a429" +%T)), rotate signal, в сутках $((today+1))/$MAX_PER_DAY"
        signal_rotate
        sleep 3
        restart_app_if_stale_429 >/dev/null 2>&1
      fi
    fi
    sleep "$POLL_SECS"
  done
}

daemon_running() {
  [[ -f "$DAEMON_PID" ]] && kill -0 "$(cat "$DAEMON_PID")" 2>/dev/null
}

daemon_start() {
  daemon_running && return 0
  nohup "$0" _loop >>"$DAEMON_LOG" 2>&1 &
  echo $! > "$DAEMON_PID"
  disown || true
  sleep 1
  daemon_running
}

daemon_stop() {
  [[ -f "$DAEMON_PID" ]] || return 0
  local pid; pid=$(cat "$DAEMON_PID")
  if kill -0 "$pid" 2>/dev/null; then
    local child
    for child in $(pgrep -P "$pid" 2>/dev/null); do kill "$child" 2>/dev/null || true; done
    kill "$pid" 2>/dev/null || true
    sleep 0.3
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$DAEMON_PID"
}

do_on() {
  db_init
  [[ -x "$OPENCODE_APP_BIN" ]] || die "OpenCode.app не найден: $OPENCODE_APP_BIN"
  ipv6_wifi_on
  step "поднимаю zen-proxy ($ZEN_PROXY_URL)"
  if ! start_zen_proxy; then die "zen-proxy не стартовал, лог: $ZEN_PROXY_LOG"; fi
  ok "zen-proxy pid=$(cat "$ZEN_PROXY_PID"), источник один /128 на старте"
  if app_running && sidecar_proxied_to_zen; then
    ok "OpenCode уже через zen-proxy"
  else
    step "запуск OpenCode через zen-proxy"
    app_quit_wait && app_launch_proxied && ok "OpenCode.app через $ZEN_PROXY_URL"
  fi
  step "safe-mode daemon (poll ${POLL_SECS}s, min-interval ${MIN_INTERVAL_SECS}s, max ${MAX_PER_DAY}/день)"
  daemon_start && ok "daemon pid=$(cat "$DAEMON_PID"), лог: $DAEMON_LOG"
}

do_off() {
  db_init
  step "останавливаю daemon"
  daemon_stop
  step "останавливаю zen-proxy (сам чистит /128)"
  stop_zen_proxy
  if app_running; then
    step "рестарт OpenCode (прямой выход)"
    app_quit_wait && app_launch_direct && ok "OpenCode без прокси"
  fi
  ok "выключено"
}

do_status() {
  db_init
  step "zen-proxy"
  if zen_proxy_running; then
    echo "running pid=$(cat "$ZEN_PROXY_PID") на $ZEN_PROXY_URL"
    tail -5 "$ZEN_PROXY_LOG" 2>/dev/null | sed 's/^/  /'
  else
    echo "stopped"
  fi
  step "daemon"
  if daemon_running; then
    echo "running pid=$(cat "$DAEMON_PID"), лог: $DAEMON_LOG"
    tail -3 "$DAEMON_LOG" 2>/dev/null | sed 's/^/  /'
  else
    echo "stopped"
  fi
  step "ротаций сегодня: $(rotations_today)/$MAX_PER_DAY (min-interval ${MIN_INTERVAL_SECS}s)"
  local lrot; lrot=$(last_rotation_ts)
  if (( lrot > 0 )); then
    echo "последняя: $(date -r "$lrot" +'%Y-%m-%d %H:%M:%S')"
  else
    echo "ещё не было"
  fi
  step "sidecar env"
  local env; env=$(sidecar_proxy_env)
  echo "${env:-нет сайдкара}"
}

case "${1:-}" in
  on)     do_on ;;
  off)    do_off ;;
  status) do_status ;;
  _loop)  do_daemon_loop ;;
  *)
    cat <<EOF
Usage: $0 <cmd>
  on      поднять zen-proxy (один /128 долгоживущий), OpenCode через него, safe-mode daemon
          (ротирует /128 только при 429 в opencode.db, не чаще раза в ${MIN_INTERVAL_SECS}s, максимум ${MAX_PER_DAY}/день)
  off     остановить daemon и zen-proxy, рестарт OpenCode без прокси
  status  состояние, счётчик ротаций за сутки, последняя ротация
EOF
    exit 1 ;;
esac
