#!/usr/bin/env bash
set -euo pipefail

OPENCODE_PID_PAT="opencode-cli serve --service"
IPIFY="https://api.ipify.org"
ZEN="https://opencode.ai/zen/v1/chat/completions"

step() { printf "\n\033[1;34m== %s\033[0m\n" "$*"; }
ok()   { printf "\033[1;32mOK\033[0m  %s\n" "$*"; }
warn() { printf "\033[1;33m!!\033[0m  %s\n" "$*"; }
die()  { printf "\033[1;31mXX\033[0m  %s\n" "$*" >&2; exit 1; }

cur_ip() { curl -s --max-time 5 "$IPIFY" || echo unknown; }

probe_zen() {
  curl -s -o /dev/null --max-time 10 -w "%{http_code}" "$ZEN" \
    -H "Authorization: Bearer public" \
    -H "Content-Type: application/json" \
    -H "x-opencode-session: ses_$(openssl rand -hex 13)" \
    -H "User-Agent: opencode/2.0.24" \
    -d '{"model":"space-bunny-free","messages":[{"role":"user","content":"hi"}],"max_tokens":1}'
}

ensure_warp() {
  if command -v warp-cli >/dev/null; then
    ok "warp-cli найден"
    return
  fi
  if ! command -v brew >/dev/null; then
    die "brew не найден. Поставь Homebrew или WARP вручную: https://1.1.1.1"
  fi
  step "Ставлю Cloudflare WARP (brew cask)"
  brew install --cask cloudflare-warp
}

warp_up() {
  local before="$1"
  warp-cli --accept-tos registration new 2>/dev/null || true
  warp-cli --accept-tos connect 2>/dev/null || warp-cli connect
  for i in $(seq 1 20); do
    sleep 1
    now=$(cur_ip)
    if [[ -n "$now" && "$now" != "unknown" && "$now" != "$before" ]]; then
      ok "WARP маршрутизирует: $before -> $now"
      return
    fi
  done
  warn "IP не сменился за 20 сек. Статус WARP:"
  warp-cli status 2>&1 | head -3
  die "Открой приложение 1.1.1.1 вручную и жми Connect, потом запусти снова."
}

warp_down() { warp-cli disconnect >/dev/null 2>&1 || true; }

bounce_opencode() {
  pids=$(pgrep -f "$OPENCODE_PID_PAT" || true)
  [[ -z "$pids" ]] && { warn "opencode-cli не запущен, перезапуск не нужен"; return; }
  step "Перезапускаю opencode-cli ($pids), чтобы оборвать уже открытые соединения"
  kill $pids
  sleep 2
  pgrep -f "$OPENCODE_PID_PAT" >/dev/null && ok "сайдкар поднялся заново" \
    || warn "сайдкар не поднялся сам - открой окно OpenCode"
}

cmd=${1:-on}
case "$cmd" in
  status)
    step "Текущий публичный IP"
    echo "  $(cur_ip)"
    step "WARP"
    command -v warp-cli >/dev/null && warp-cli status 2>&1 | head -3 || echo "не установлен"
    step "Проверка Zen (одним запросом)"
    code=$(probe_zen); echo "  HTTP $code"
    [[ "$code" == "200" ]] && ok "лимит свободен" || warn "лимит выбран или сетка"
    ;;
  on)
    before=$(cur_ip); step "IP до: $before"
    ensure_warp
    warp_up "$before"
    sleep 1
    after=$(cur_ip); step "IP после: $after"
    [[ "$before" == "$after" ]] && die "IP не сменился - WARP не маршрутизирует трафик"
    code=$(probe_zen); step "Zen HTTP: $code"
    if [[ "$code" == "200" ]]; then
      bounce_opencode
      ok "готово. OpenCode теперь ходит в Zen с $after."
    else
      warn "Zen всё ещё отвечает $code. Либо на этом IP уже кто-то выжег лимит, либо дело не в IP."
      warn "Попробуй: $0 rotate   # отключит и подключит WARP ещё раз, он даст другой exit."
    fi
    ;;
  rotate)
    step "Крутим WARP exit"
    warp-cli disconnect >/dev/null 2>&1 || true
    sleep 2
    warp-cli connect
    sleep 3
    echo "  новый IP: $(cur_ip)"
    code=$(probe_zen); echo "  Zen HTTP: $code"
    [[ "$code" == "200" ]] && bounce_opencode && ok "готово"
    ;;
  off)
    step "Выключаю WARP"
    warp_down
    sleep 1
    step "IP: $(cur_ip)"
    bounce_opencode
    ;;
  *)
    cat <<EOF
Usage: $0 {status|on|rotate|off}
  status - показать IP, статус WARP и ответ Zen
  on     - включить WARP, проверить Zen, перезапустить opencode-cli
  rotate - переподключить WARP (новый exit)
  off    - выключить WARP, вернуть прямое соединение
EOF
    exit 1
    ;;
esac
