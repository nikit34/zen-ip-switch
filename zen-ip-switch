#!/usr/bin/env bash
set -euo pipefail

OPENCODE_APP_BIN="${ZEN_OPENCODE_APP_BIN:-/Applications/OpenCode.app/Contents/MacOS/OpenCode}"
OPENCODE_PID_PAT="opencode-cli serve --service"
OC_DB="${ZEN_OC_DB:-$HOME/.local/share/opencode/opencode.db}"
STATE_DIR="${ZEN_STATE_DIR:-$HOME/.local/share/zen-ip-switch}"
DB="$STATE_DIR/metrics.db"
DAEMON_PID="$STATE_DIR/daemon.pid"
DAEMON_LOG="$STATE_DIR/daemon.log"
DAEMON_LOCK_DIR="$STATE_DIR/daemon.lock"
APP_QUIT_WAIT="${ZEN_APP_QUIT_WAIT:-15}"
WARP_PROXY_PORT="${ZEN_WARP_PROXY_PORT:-40000}"
PRIVOXY_PORT="${ZEN_PRIVOXY_PORT:-8787}"
PRIVOXY_CONF="$STATE_DIR/privoxy.conf"
PRIVOXY_PID="$STATE_DIR/privoxy.pid"
PRIVOXY_LOG="$STATE_DIR/privoxy.log"
ZEN_PROXY_URL="http://127.0.0.1:${PRIVOXY_PORT}"
ZEN_HOST="opencode.ai"

POLL_SECS="${ZEN_POLL_SECS:-60}"
MIN_INTERVAL_SECS="${ZEN_MIN_INTERVAL_SECS:-600}"
MAX_PER_DAY="${ZEN_MAX_PER_DAY:-8}"
BURNT_PAUSE_SECS="${ZEN_BURNT_PAUSE_SECS:-14400}"

mkdir -p "$STATE_DIR"

step() { printf "\n\033[1;34m== %s\033[0m\n" "$*"; }
ok()   { printf "\033[1;32mOK\033[0m  %s\n" "$*"; }
warn() { printf "\033[1;33m!!\033[0m  %s\n" "$*"; }
die()  { printf "\033[1;31mXX\033[0m  %s\n" "$*" >&2; exit 1; }

db_init() {
  sqlite3 "$DB" <<SQL
CREATE TABLE IF NOT EXISTS rotations (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  ts INTEGER NOT NULL, reason TEXT,
  first_ts INTEGER, first_status INTEGER
);
CREATE INDEX IF NOT EXISTS rotations_ts ON rotations(ts);
SQL
  if [[ -z "$(sqlite3 "$DB" "SELECT 1 FROM pragma_table_info('rotations') WHERE name='first_status';")" ]]; then
    sqlite3 "$DB" "ALTER TABLE rotations ADD COLUMN first_ts INTEGER; ALTER TABLE rotations ADD COLUMN first_status INTEGER;"
  fi
  if [[ -z "$(sqlite3 "$DB" "SELECT 1 FROM pragma_table_info('rotations') WHERE name='first_retry_ms';")" ]]; then
    sqlite3 "$DB" "ALTER TABLE rotations ADD COLUMN first_retry_ms INTEGER;"
  fi
  if [[ -z "$(sqlite3 "$DB" "SELECT 1 FROM pragma_table_info('rotations') WHERE name='first_model';")" ]]; then
    sqlite3 "$DB" "ALTER TABLE rotations ADD COLUMN first_model TEXT;"
  fi
}

log_rotation() { sqlite3 "$DB" "INSERT INTO rotations(ts,reason) VALUES ($(date +%s),'${1//\'/\'\'}');"; }

app_running() { pgrep -f "$OPENCODE_APP_BIN" >/dev/null; }

app_quit_wait() {
  if app_running; then
    osascript -e 'tell application "OpenCode" to quit' 2>/dev/null || true
    local waited=0
    while (( waited < APP_QUIT_WAIT )); do
      sleep 1; waited=$((waited+1))
      app_running || break
    done
    app_running && { warn "OpenCode.app не закрылся за ${APP_QUIT_WAIT} сек"; return 1; }
  fi
  pgrep -f "$OPENCODE_PID_PAT" 2>/dev/null | xargs -r kill 2>/dev/null || true
  return 0
}

app_launch_direct() { open -a OpenCode; }
app_launch_proxied() {
  open -a OpenCode \
    --env "ALL_PROXY=$ZEN_PROXY_URL" \
    --env "HTTPS_PROXY=$ZEN_PROXY_URL" \
    --env "HTTP_PROXY=$ZEN_PROXY_URL"
}

warp_connected() { warp-cli status 2>/dev/null | grep -q "Connected"; }

ensure_warp_proxy_mode() {
  warp-cli mode proxy >/dev/null 2>&1 || true
  warp-cli proxy port "$WARP_PROXY_PORT" >/dev/null 2>&1 || true
}

write_privoxy_conf() {
  cat > "$PRIVOXY_CONF" <<EOF
listen-address 127.0.0.1:${PRIVOXY_PORT}
forward-socks5t / 127.0.0.1:${WARP_PROXY_PORT} .
confdir ${STATE_DIR}
logdir ${STATE_DIR}
logfile privoxy.log
toggle 1
accept-intercepted-requests 0
allow-cgi-request-crunching 0
split-large-forms 0
keep-alive-timeout 60
tolerate-pipelining 1
debug 1
debug 512
EOF
}

ensure_privoxy() {
  if ! command -v privoxy >/dev/null 2>&1; then
    if command -v brew >/dev/null 2>&1; then brew install privoxy >/dev/null 2>&1 || die "не удалось установить privoxy"; else die "privoxy не найден"; fi
  fi
  [[ -f "$PRIVOXY_CONF" ]] || write_privoxy_conf
}

privoxy_running() {
  if [[ -f "$PRIVOXY_PID" ]] && kill -0 "$(cat "$PRIVOXY_PID")" 2>/dev/null; then return 0; fi
  rm -f "$PRIVOXY_PID"
  # проверяем, кто слушает наш порт (не подхватываем чужой privoxy на другом порту)
  local pid; pid=$(lsof -tiTCP:"$PRIVOXY_PORT" -sTCP:LISTEN 2>/dev/null | head -1 || true)
  if [[ -n "$pid" ]]; then echo "$pid" > "$PRIVOXY_PID"; return 0; fi
  return 1
}

start_privoxy() {
  privoxy_running && return 0
  ensure_privoxy
  write_privoxy_conf
  /opt/homebrew/sbin/privoxy "$PRIVOXY_CONF" >/dev/null 2>&1 || /usr/local/sbin/privoxy "$PRIVOXY_CONF" >/dev/null 2>&1 || privoxy "$PRIVOXY_CONF" >/dev/null 2>&1 || true
  sleep 1
  local pid; pid=$(pgrep -x privoxy | head -1 || true)
  [[ -n "$pid" ]] && echo "$pid" > "$PRIVOXY_PID"
  privoxy_running
}

stop_privoxy() {
  local pid=""
  [[ -f "$PRIVOXY_PID" ]] && pid=$(cat "$PRIVOXY_PID" 2>/dev/null || true)
  [[ -z "$pid" ]] && pid=$(pgrep -x privoxy | head -1 || true)
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    sleep 1
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PRIVOXY_PID"
  pkill -x privoxy 2>/dev/null || true
}

sidecar_proxy_env() {
  local pid; pid=$(pgrep -f "$OPENCODE_PID_PAT" 2>/dev/null | head -1 || true)
  [[ -z "$pid" ]] && { echo ""; return; }
  ps eww -p "$pid" 2>/dev/null | tr ' ' '\n' | grep -E "^ALL_PROXY=" | head -1 | tr -d '\n'
}

sidecar_proxied_to_zen() {
  [[ "$(sidecar_proxy_env)" == "ALL_PROXY=$ZEN_PROXY_URL" ]]
}

app_last_429_ts() {
  [[ -f "$OC_DB" ]] || { echo 0; return; }
  sqlite3 "$OC_DB" "SELECT COALESCE(MAX(time_updated),0)/1000 FROM session_message WHERE json_extract(data,'$.error.status')=429 AND json_extract(data,'$.model.providerID')='opencode';" 2>/dev/null || echo 0
}

last_rotation_ts() {
  sqlite3 "$DB" "SELECT COALESCE(MAX(ts),0) FROM rotations WHERE reason NOT LIKE '%failed';" 2>/dev/null || echo 0
}

rotations_today() {
  local day_start; day_start=$(date -v0H -v0M -v0S +%s)
  sqlite3 "$DB" "SELECT COUNT(*) FROM rotations WHERE ts >= $day_start;" 2>/dev/null || echo 0
}

first_request_after() {
  local from="$1" to="$2"
  sqlite3 "$OC_DB" "SELECT time_created/1000, COALESCE(json_extract(data,'$.error.status'),200), COALESCE(json_extract(data,'$.error.retryAfterMs'),0), COALESCE(json_extract(data,'$.model.id'),'') FROM session_message WHERE type='assistant' AND json_extract(data,'$.model.providerID')='opencode' AND time_created >= $((from * 1000)) AND time_created < $((to * 1000)) AND json_extract(data,'$.time.completed') IS NOT NULL AND (json_extract(data,'$.finish') IS NOT 'error' OR json_extract(data,'$.error.status') IS NOT NULL) ORDER BY time_created LIMIT 1;" 2>/dev/null
}

record_first_results() {
  [[ -f "$OC_DB" ]] || return 0
  local id ts next row
  while IFS='|' read -r id ts next; do
    row=$(first_request_after "$ts" "${next:-$(date +%s)}") || continue
    if [[ -n "$row" ]]; then
      local fts fstatus fretry fmodel
      fts="${row%%|*}"; row="${row#*|}"
      fstatus="${row%%|*}"; row="${row#*|}"
      fretry="${row%%|*}"; row="${row#*|}"
      fmodel="$row"
      sqlite3 "$DB" "UPDATE rotations SET first_ts=$fts, first_status=$fstatus, first_retry_ms=$fretry, first_model='$fmodel' WHERE id=$id;"
      echo "$(date -u -r "$ts" +%FT%TZ) ротация: первый запрос $(date -u -r "$fts" +%TZ) -> $fstatus model=$fmodel retryMs=$fretry"
    elif [[ -n "$next" ]]; then
      sqlite3 "$DB" "UPDATE rotations SET first_status=0 WHERE id=$id;"
    fi
  done < <(sqlite3 "$DB" "SELECT id, ts, (SELECT MIN(n.ts) FROM rotations n WHERE n.ts > r.ts) FROM rotations r WHERE first_status IS NULL AND reason NOT LIKE '%failed' ORDER BY ts;")
}

burnt_until_ts() {
  sqlite3 "$DB" "SELECT COALESCE(MAX(ts + CASE WHEN first_retry_ms IS NOT NULL AND first_retry_ms > 0 AND first_retry_ms/1000 < $BURNT_PAUSE_SECS THEN first_retry_ms/1000 ELSE $BURNT_PAUSE_SECS END), 0) FROM rotations WHERE first_status=429 AND reason NOT LIKE '%failed' AND ts > $(( $(date +%s) - BURNT_PAUSE_SECS ));" 2>/dev/null || echo 0
}

first_status_label() {
  case "$1" in
    "")  echo "запросов ещё не было" ;;
    0)   echo "до следующей ротации запросов не было" ;;
    200) echo "OK" ;;
    *)   echo "HTTP $1" ;;
  esac
}

cur_ip_warp() { curl -s --socks5-hostname "127.0.0.1:${WARP_PROXY_PORT}" --max-time 8 "https://${ZEN_HOST}/cdn-cgi/trace" 2>/dev/null | awk -F= '/^ip=/ {print $2}' || echo ""; }

warp_reregister() {
  warp-cli disconnect >/dev/null 2>&1 || true
  warp-cli registration delete >/dev/null 2>&1 || true
  sleep 1
  warp-cli --accept-tos registration new >/dev/null 2>&1 || return 1
  warp-cli mode proxy >/dev/null 2>&1 || true
  warp-cli proxy port "$WARP_PROXY_PORT" >/dev/null 2>&1 || true
  return 0
}

warp_rotate_exit() {
  local before="$1"
  warp_reregister || return 1
  warp-cli --accept-tos connect >/dev/null 2>&1 || warp-cli connect >/dev/null 2>&1 || true
  local i now
  for i in $(seq 1 20); do
    sleep 1
    now=$(cur_ip_warp)
    if [[ -n "$now" && "$now" != "$before" ]]; then echo "$now"; return 0; fi
  done
  echo ""
  return 1
}

do_rotate() {
  local reason="${1:-manual}"
  db_init
  ensure_warp_proxy_mode
  if ! warp_connected; then
    warp-cli connect >/dev/null 2>&1 || true
    local i
    for i in $(seq 1 20); do warp_connected && break; sleep 1; done
  fi
  if ! warp_connected; then
    echo "rotate failed: WARP не подключился" >&2
    log_rotation "${reason}:failed"
    return 1
  fi
  local before; before=$(cur_ip_warp)
  [[ -z "$before" ]] && { echo "rotate failed: не удалось получить текущий exit" >&2; log_rotation "${reason}:failed"; return 1; }
  start_privoxy || { echo "rotate failed: privoxy не стартовал" >&2; log_rotation "${reason}:failed"; return 1; }
  local after; after=$(warp_rotate_exit "$before")
  if [[ -z "$after" ]]; then
    echo "rotate failed: exit не изменился ($before)" >&2
    log_rotation "${reason}:failed"
    return 1
  fi
  ok "WARP exit: $before -> $after"
  log_rotation "$reason"
  return 0
}

acquire_daemon_lock() {
  if ! mkdir "$DAEMON_LOCK_DIR" 2>/dev/null; then
    local owner=""
    [[ -f "$DAEMON_LOCK_DIR/pid" ]] && owner=$(cat "$DAEMON_LOCK_DIR/pid" 2>/dev/null || true)
    if [[ -n "$owner" ]] && kill -0 "$owner" 2>/dev/null; then
      echo "daemon уже запущен (pid=$owner)" >&2
      return 1
    fi
    rmdir "$DAEMON_LOCK_DIR" 2>/dev/null || return 1
    mkdir "$DAEMON_LOCK_DIR" 2>/dev/null || return 1
  fi
  echo "$$" > "$DAEMON_LOCK_DIR/pid"
  echo "$$" > "$DAEMON_PID"
  return 0
}

do_daemon_loop() {
  db_init
  acquire_daemon_lock || exit 0
  trap 'rm -f "$DAEMON_LOCK_DIR/pid" "$DAEMON_PID"; rmdir "$DAEMON_LOCK_DIR" 2>/dev/null || true' EXIT INT TERM
  set +e
  while true; do
    local ts a429 lrot now gap today burnt
    ts=$(date -u +%FT%TZ)
    record_first_results
    a429=$(app_last_429_ts); lrot=$(last_rotation_ts); now=$(date +%s)
    # самоподнимаем privoxy
    if ! privoxy_running; then
      if start_privoxy >/dev/null 2>&1; then
        echo "$ts privoxy был мёртв, поднят pid=$(cat "$PRIVOXY_PID" 2>/dev/null)"
      else
        echo "$ts privoxy не поднялся"
      fi
    fi
    if (( a429 > lrot )); then
      gap=$(( now - lrot ))
      today=$(rotations_today)
      burnt=$(burnt_until_ts)
      if (( burnt > 0 )); then
        echo "$ts свежий 429 но новый exit сразу получил 429, ротации стоят до $(date -r "$burnt" +%T)"
      elif (( gap < MIN_INTERVAL_SECS )); then
        echo "$ts свежий 429 но слишком рано ($gap < ${MIN_INTERVAL_SECS}s), жду"
      elif (( today >= MAX_PER_DAY )); then
        echo "$ts свежий 429 но daily cap ($today/$MAX_PER_DAY), жду до завтра"
      else
        echo "$ts свежий 429 ($(date -r "$a429" +%T)), rotate, в сутках $((today+1))/$MAX_PER_DAY"
        do_rotate "auto429" || echo "$ts rotate failed"
      fi
    fi
    sleep "$POLL_SECS"
  done
}

daemon_running() {
  [[ -f "$DAEMON_LOCK_DIR/pid" ]] && kill -0 "$(cat "$DAEMON_LOCK_DIR/pid")" 2>/dev/null
}

daemon_start() {
  daemon_running && return 0
  nohup "$0" _loop >>"$DAEMON_LOG" 2>&1 &
  disown || true
  sleep 1
  daemon_running
}

daemon_stop() {
  [[ -f "$DAEMON_LOCK_DIR/pid" ]] || { rm -f "$DAEMON_PID"; rmdir "$DAEMON_LOCK_DIR" 2>/dev/null || true; return 0; }
  local pid; pid=$(cat "$DAEMON_LOCK_DIR/pid")
  if kill -0 "$pid" 2>/dev/null; then
    local child
    for child in $(pgrep -P "$pid" 2>/dev/null); do kill "$child" 2>/dev/null || true; done
    kill "$pid" 2>/dev/null || true
    sleep 0.3
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$DAEMON_LOCK_DIR/pid" "$DAEMON_PID"
  rmdir "$DAEMON_LOCK_DIR" 2>/dev/null || true
}

do_on() {
  db_init
  [[ -x "$OPENCODE_APP_BIN" ]] || die "OpenCode.app не найден: $OPENCODE_APP_BIN"
  ensure_warp_proxy_mode
  step "подключаю WARP (proxy-mode)"
  if ! warp_connected; then
    warp-cli connect >/dev/null 2>&1 || true
    local i
    for i in $(seq 1 20); do warp_connected && break; sleep 1; done
  fi
  warp_connected || die "WARP не подключился"
  ok "WARP connected"
  step "поднимаю privoxy (HTTP->SOCKS мост)"
  if ! start_privoxy; then die "privoxy не стартовал, лог: $PRIVOXY_LOG"; fi
  ok "privoxy pid=$(cat "$PRIVOXY_PID") на $ZEN_PROXY_URL"
  if app_running && sidecar_proxied_to_zen; then
    ok "OpenCode уже через privoxy"
  else
    step "запуск OpenCode через privoxy"
    app_quit_wait && app_launch_proxied && ok "OpenCode.app через $ZEN_PROXY_URL"
  fi
  step "daemon (poll ${POLL_SECS}s, min-interval ${MIN_INTERVAL_SECS}s, max ${MAX_PER_DAY}/день)"
  daemon_start && ok "daemon pid=$(cat "$DAEMON_PID"), лог: $DAEMON_LOG"
}

do_off() {
  db_init
  step "останавливаю daemon"
  daemon_stop
  step "останавливаю privoxy"
  stop_privoxy
  step "отключаю WARP"
  warp-cli disconnect >/dev/null 2>&1 || true
  if app_running; then
    step "рестарт OpenCode (прямой выход)"
    app_quit_wait && app_launch_direct && ok "OpenCode без прокси"
  fi
  ok "выключено"
}

do_status() {
  db_init
  step "WARP"
  if warp_connected; then echo "connected (proxy-mode :$WARP_PROXY_PORT)"; else echo "disconnected"; fi
  step "privoxy"
  if privoxy_running; then
    echo "running pid=$(cat "$PRIVOXY_PID") на $ZEN_PROXY_URL"
  else
    echo "stopped"
  fi
  step "daemon"
  if daemon_running; then
    echo "running pid=$(cat "$DAEMON_PID"), лог: $DAEMON_LOG"
    tail -3 "$DAEMON_LOG" 2>/dev/null | sed 's/^/  /'
  else
    echo "stopped"
  fi
  record_first_results >/dev/null
  step "ротаций сегодня: $(rotations_today)/$MAX_PER_DAY (min-interval ${MIN_INTERVAL_SECS}s)"
  local lrot; lrot=$(last_rotation_ts)
  if (( lrot > 0 )); then
    echo "последняя: $(date -r "$lrot" +'%Y-%m-%d %H:%M:%S'), первый запрос после неё: $(first_status_label "$(sqlite3 "$DB" "SELECT first_status FROM rotations WHERE ts=$lrot ORDER BY id DESC LIMIT 1;")")"
  else
    echo "ещё не было"
  fi
  local burnt; burnt=$(burnt_until_ts)
  if (( burnt > 0 )); then
    warn "ротации стоят до $(date -r "$burnt" +%T): новый exit сразу получил 429 (пауза ${BURNT_PAUSE_SECS}s)"
  fi
  step "sidecar env"
  local env; env=$(sidecar_proxy_env)
  echo "${env:-нет сайдкара}"
  step "exit IP"
  curl -sx "$ZEN_PROXY_URL" -s --max-time 5 https://opencode.ai/cdn-cgi/trace 2>/dev/null | grep '^ip=' || echo "n/a"
}

case "${1:-}" in
  on)     do_on ;;
  off)    do_off ;;
  status) do_status ;;
  rotate) do_rotate "${2:-manual}" ;;
  _loop)  do_daemon_loop ;;
  *)
    cat <<EOF
Usage: $0 <cmd>
  on      поднять WARP proxy-mode + privoxy + перезапуск OpenCode с ALL_PROXY
  off     отключить WARP + privoxy + рестарт OpenCode без прокси
  status  состояние
  rotate  переподключить WARP (новый exit), OpenCode не трогается
EOF
    exit 1 ;;
esac
