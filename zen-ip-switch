#!/usr/bin/env bash
set -euo pipefail

OPENCODE_PID_PAT="opencode-cli serve --service"
OPENCODE_APP_BIN="/Applications/OpenCode.app/Contents/MacOS/OpenCode"
IPIFY="https://api.ipify.org"
ZEN_HOST="opencode.ai"
ZEN_BASE="https://${ZEN_HOST}/zen/v1"
STATE_DIR="${ZEN_STATE_DIR:-$HOME/.local/share/zen-ip-switch}"
DB="$STATE_DIR/metrics.db"
DAEMON_PID="$STATE_DIR/daemon.pid"
DAEMON_LOG="$STATE_DIR/daemon.log"
POLL_SECS="${ZEN_POLL_SECS:-120}"
IP_WAIT_SECS="${ZEN_IP_WAIT_SECS:-20}"
MAX_ROTATE_TRIES="${ZEN_MAX_ROTATE_TRIES:-5}"
WARP_PROXY_PORT="${ZEN_WARP_PROXY_PORT:-40000}"
WARP_PROXY_URL="socks5h://127.0.0.1:${WARP_PROXY_PORT}"
APP_QUIT_WAIT="${ZEN_APP_QUIT_WAIT:-15}"

mkdir -p "$STATE_DIR"

step() { printf "\n\033[1;34m== %s\033[0m\n" "$*"; }
ok()   { printf "\033[1;32mOK\033[0m  %s\n" "$*"; }
warn() { printf "\033[1;33m!!\033[0m  %s\n" "$*"; }
die()  { printf "\033[1;31mXX\033[0m  %s\n" "$*" >&2; exit 1; }

db_init() {
  sqlite3 "$DB" <<SQL
CREATE TABLE IF NOT EXISTS rotations (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  ts INTEGER NOT NULL,
  before_ip TEXT,
  after_ip TEXT,
  zen_before INTEGER,
  zen_after INTEGER,
  model TEXT,
  reason TEXT
);
CREATE TABLE IF NOT EXISTS probes (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  ts INTEGER NOT NULL,
  ip TEXT,
  model TEXT,
  code INTEGER
);
CREATE INDEX IF NOT EXISTS probes_ts ON probes(ts);
CREATE INDEX IF NOT EXISTS rotations_ts ON rotations(ts);
SQL
}

sql_int() { [[ -n "$1" && "$1" =~ ^[0-9]+$ ]] && echo "$1" || echo "NULL"; }
sql_str() { local s="${1//\'/\'\'}"; echo "'$s'"; }

log_probe() {
  local ip="$1" model="$2" code="$3"
  sqlite3 "$DB" "INSERT INTO probes(ts,ip,model,code) VALUES ($(date +%s),$(sql_str "$ip"),$(sql_str "$model"),$(sql_int "$code"));"
}

log_rotation() {
  local b="$1" a="$2" zb="$3" za="$4" m="$5" r="$6"
  sqlite3 "$DB" "INSERT INTO rotations(ts,before_ip,after_ip,zen_before,zen_after,model,reason) VALUES ($(date +%s),$(sql_str "$b"),$(sql_str "$a"),$(sql_int "$zb"),$(sql_int "$za"),$(sql_str "$m"),$(sql_str "$r"));"
}

warp_connected() {
  warp-cli status 2>/dev/null | head -1 | grep -q "Connected"
}

cur_ip_direct() { curl -s --max-time 5 "$IPIFY" || echo ""; }
cur_ip_warp()   { curl -s --socks5-hostname "127.0.0.1:${WARP_PROXY_PORT}" --max-time 8 "$IPIFY" || echo ""; }

discover_free_model() {
  curl -s --max-time 10 "$ZEN_BASE/models" \
    -H "User-Agent: opencode/2.0.24" \
    | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("space-bunny-free"); sys.exit(0)
free = [m["id"] for m in d.get("data", []) if isinstance(m, dict) and m.get("id","").endswith("-free")]
free = [m for m in free if not m.startswith("jev-")]
for pref in ("space-bunny-free","mimo-v2.6-flash-free","nemotron-3-ultra-free","longcat-2.5-preview-free"):
    if pref in free: print(pref); sys.exit(0)
print(free[0] if free else "space-bunny-free")
' 2>/dev/null || echo "space-bunny-free"
}

probe_zen() {
  local model="$1"
  local proxy_arg=()
  if warp_connected; then proxy_arg=(--socks5-hostname "127.0.0.1:${WARP_PROXY_PORT}"); fi
  curl -s -o /dev/null --max-time 12 "${proxy_arg[@]}" -w "%{http_code}" "$ZEN_BASE/chat/completions" \
    -H "Authorization: Bearer public" \
    -H "Content-Type: application/json" \
    -H "x-opencode-session: ses_$(openssl rand -hex 13)" \
    -H "User-Agent: opencode/2.0.24" \
    -d "{\"model\":\"$model\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":1}"
}

ensure_warp() {
  if command -v warp-cli >/dev/null; then return; fi
  if ! command -v brew >/dev/null; then
    die "brew не найден. Поставь Homebrew или WARP вручную: https://1.1.1.1"
  fi
  step "Ставлю Cloudflare WARP"
  brew install --cask cloudflare-warp
}

ensure_proxy_mode() {
  local mode; mode=$(warp-cli settings 2>/dev/null | awk '/^.*Mode:/ {print $NF; exit}')
  if [[ "$mode" != "Proxy" && "$mode" != "proxy" ]]; then
    step "перевожу WARP в proxy mode (SOCKS5 на 127.0.0.1:${WARP_PROXY_PORT})"
    warp-cli --accept-tos registration new >/dev/null 2>&1 || true
    warp-cli mode proxy >/dev/null 2>&1 || die "не смог поставить proxy mode"
    warp-cli proxy port "$WARP_PROXY_PORT" >/dev/null 2>&1 || true
  fi
}

warp_up() {
  local before_warp_ip; before_warp_ip=$(cur_ip_warp)
  warp-cli --accept-tos connect >/dev/null 2>&1 || warp-cli connect >/dev/null 2>&1 || true
  for _ in $(seq 1 "$IP_WAIT_SECS"); do
    sleep 1
    warp_connected && { echo "$(cur_ip_warp)"; return 0; }
  done
  echo ""
  return 1
}

warp_rotate_exit() {
  local before="$1"
  warp-cli disconnect >/dev/null 2>&1 || true
  sleep 2
  warp-cli --accept-tos connect >/dev/null 2>&1 || warp-cli connect >/dev/null 2>&1 || true
  for _ in $(seq 1 "$IP_WAIT_SECS"); do
    sleep 1
    local now; now=$(cur_ip_warp)
    if [[ -n "$now" && "$now" != "$before" ]]; then echo "$now"; return 0; fi
  done
  echo ""
  return 1
}

app_running()  { pgrep -f "$OPENCODE_APP_BIN" >/dev/null; }

kill_sidecar() {
  local pid; pid=$(pgrep -f "$OPENCODE_PID_PAT" 2>/dev/null | head -1 || true)
  [[ -z "$pid" ]] && return
  kill "$pid" 2>/dev/null || true
  sleep 1
  kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
}

app_quit_wait() {
  if app_running; then
    osascript -e 'tell application "OpenCode" to quit' 2>/dev/null || true
    local waited=0
    while (( waited < APP_QUIT_WAIT )); do
      sleep 1; waited=$((waited+1))
      app_running || break
    done
    if app_running; then
      warn "OpenCode.app не закрылся за ${APP_QUIT_WAIT} сек"
      return 1
    fi
  fi
  kill_sidecar
  return 0
}

app_launch_with_proxy() {
  nohup env \
    ALL_PROXY="$WARP_PROXY_URL" \
    HTTPS_PROXY="$WARP_PROXY_URL" \
    HTTP_PROXY="$WARP_PROXY_URL" \
    "$OPENCODE_APP_BIN" >/dev/null 2>&1 &
  disown || true
}

app_launch_direct() {
  nohup "$OPENCODE_APP_BIN" >/dev/null 2>&1 &
  disown || true
}

sidecar_has_proxy_env() {
  local pid; pid=$(pgrep -f "$OPENCODE_PID_PAT" 2>/dev/null | head -1 || true)
  [[ -z "$pid" ]] && { echo 0; return; }
  ps eww -p "$pid" 2>/dev/null | tr ' ' '\n' | grep -qE "^(ALL_PROXY|HTTPS_PROXY)=" && echo 1 || echo 0
}

do_on() {
  db_init
  ensure_warp
  ensure_proxy_mode
  step "включаю WARP (proxy mode, SOCKS 127.0.0.1:${WARP_PROXY_PORT})"
  local warp_ip; warp_ip=$(warp_up)
  [[ -z "$warp_ip" ]] && die "WARP не поднялся. Открой приложение 1.1.1.1 вручную."
  ok "WARP exit: $warp_ip (прямой IP остался $(cur_ip_direct))"
  local model; model=$(discover_free_model)
  local code; code=$(probe_zen "$model"); log_probe "$warp_ip" "$model" "$code"
  step "Zen через SOCKS: HTTP $code (модель $model)"
  if [[ "$code" != "200" ]]; then
    warn "exit $warp_ip тоже выжат, запусти: $0 rotate"
    return
  fi
  log_rotation "$(cur_ip_direct)" "$warp_ip" "" "$code" "$model" "on"
  if app_running; then
    if [[ "$(sidecar_has_proxy_env)" == "1" ]]; then
      ok "OpenCode уже стартован с прокси, перезапускать не надо"
    else
      step "перезапускаю OpenCode.app с ALL_PROXY=$WARP_PROXY_URL"
      app_quit_wait && app_launch_with_proxy && ok "OpenCode.app запущен через SOCKS"
    fi
  else
    step "OpenCode.app не запущен, стартую через SOCKS"
    app_launch_with_proxy && ok "OpenCode.app запущен"
  fi
}

do_rotate() {
  local reason="${1:-manual}"
  db_init
  warp_connected || die "WARP не в режиме Connected. Сначала: $0 on"
  local before; before=$(cur_ip_warp)
  local model; model=$(discover_free_model)
  local zb; zb=$(probe_zen "$model"); log_probe "$before" "$model" "$zb"
  local after="" try=0 za=""
  for try in $(seq 1 "$MAX_ROTATE_TRIES"); do
    step "ротация $try/$MAX_ROTATE_TRIES: $before -> ..."
    after=$(warp_rotate_exit "$before" || true)
    [[ -z "$after" ]] && { warn "WARP не сменил exit на попытке $try"; continue; }
    za=$(probe_zen "$model"); log_probe "$after" "$model" "$za"
    if [[ "$za" == "200" ]]; then
      ok "exit $after, Zen HTTP 200 на '$model'"
      log_rotation "$before" "$after" "$zb" "$za" "$model" "$reason"
      ok "сайдкар держит keep-alive к 127.0.0.1:${WARP_PROXY_PORT}, перезапуск не нужен"
      return 0
    fi
    warn "exit $after выдал HTTP $za, пробую другой"
    before="$after"
  done
  log_rotation "$before" "${after:-}" "$zb" "0" "$model" "$reason:failed"
  die "за $MAX_ROTATE_TRIES попыток не нашёл свободный exit. Подожди или ротни через час."
}

do_off() {
  db_init
  step "выключаю WARP"
  warp-cli disconnect >/dev/null 2>&1 || true
  sleep 1
  step "IP: $(cur_ip_direct)"
  if app_running && [[ "$(sidecar_has_proxy_env)" == "1" ]]; then
    step "перезапускаю OpenCode.app без прокси (иначе будет ConnectionRefused на SOCKS)"
    app_quit_wait && app_launch_direct && ok "OpenCode.app запущен без прокси"
  else
    ok "OpenCode.app не нуждается в перезапуске"
  fi
}

do_status() {
  db_init
  step "Публичный IP (прямой): $(cur_ip_direct)"
  step "WARP"
  if command -v warp-cli >/dev/null; then
    warp-cli status 2>&1 | head -2
    if warp_connected; then
      step "WARP exit: $(cur_ip_warp) через SOCKS 127.0.0.1:${WARP_PROXY_PORT}"
    fi
  else
    echo "не установлен"
  fi
  step "OpenCode.app"
  if app_running; then
    echo "запущен, сайдкар с прокси: $(sidecar_has_proxy_env)"
  else
    echo "не запущен"
  fi
  step "Daemon"
  if [[ -f "$DAEMON_PID" ]] && kill -0 "$(cat "$DAEMON_PID")" 2>/dev/null; then
    echo "running pid=$(cat "$DAEMON_PID")  log: $DAEMON_LOG"
  else
    echo "stopped"
  fi
  step "Пробный Zen"
  local model; model=$(discover_free_model)
  local code; code=$(probe_zen "$model")
  local ip
  if warp_connected; then ip=$(cur_ip_warp); else ip=$(cur_ip_direct); fi
  log_probe "$ip" "$model" "$code"
  echo "  модель $model через $(warp_connected && echo SOCKS || echo прямо) -> HTTP $code"
}

do_stats() {
  db_init
  step "Последние 10 ротаций"
  sqlite3 -column -header "$DB" "SELECT datetime(ts,'unixepoch','localtime') AS ts, before_ip, after_ip, zen_before AS zb, zen_after AS za, model, reason FROM rotations ORDER BY ts DESC LIMIT 10;"
  step "Распределение probe-кодов за 24 часа"
  sqlite3 -column -header "$DB" "SELECT code, count(*) AS n FROM probes WHERE ts > strftime('%s','now','-1 day') GROUP BY code ORDER BY n DESC;"
  step "Последние 10 probe"
  sqlite3 -column -header "$DB" "SELECT datetime(ts,'unixepoch','localtime') AS ts, ip, model, code FROM probes ORDER BY ts DESC LIMIT 10;"
}

do_daemon_loop() {
  db_init
  while true; do
    local ts model ip code
    ts=$(date -u +%FT%TZ)
    model=$(discover_free_model)
    if warp_connected; then ip=$(cur_ip_warp); else ip=$(cur_ip_direct); fi
    code=$(probe_zen "$model")
    log_probe "$ip" "$model" "$code"
    echo "$ts ip=$ip model=$model code=$code"
    case "$code" in
      429)
        if warp_connected; then
          echo "$ts -> 429 на WARP exit, запускаю rotate auto"
          "$0" rotate auto 2>&1 || echo "$ts rotate failed"
        else
          echo "$ts -> 429 на прямом IP, но WARP выключен. Запусти: $0 on"
        fi
        ;;
      5*)
        echo "$ts -> upstream $code, ротация не поможет, пропускаю"
        ;;
    esac
    sleep "$POLL_SECS"
  done
}

do_daemon() {
  db_init
  if [[ -f "$DAEMON_PID" ]] && kill -0 "$(cat "$DAEMON_PID")" 2>/dev/null; then
    die "demon уже запущен, pid=$(cat "$DAEMON_PID")"
  fi
  ensure_warp
  step "Запускаю демон (polling каждые $POLL_SECS сек, лог $DAEMON_LOG)"
  nohup "$0" _loop >>"$DAEMON_LOG" 2>&1 &
  echo $! >"$DAEMON_PID"
  disown || true
  sleep 1
  ok "demon pid=$(cat "$DAEMON_PID")"
}

kill_tree() {
  local pid="$1"
  local child
  for child in $(pgrep -P "$pid" 2>/dev/null); do
    kill_tree "$child"
  done
  kill "$pid" 2>/dev/null || true
  sleep 0.2
  kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
}

do_daemon_stop() {
  [[ -f "$DAEMON_PID" ]] || { warn "pid-файл не найден"; return; }
  local pid; pid=$(cat "$DAEMON_PID")
  if kill -0 "$pid" 2>/dev/null; then
    kill_tree "$pid"
    ok "demon pid=$pid и его дети остановлены"
  else
    warn "pid=$pid не живой"
  fi
  rm -f "$DAEMON_PID"
}

case "${1:-}" in
  status)         do_status ;;
  on)             do_on ;;
  off)            do_off ;;
  rotate)         shift; do_rotate "${1:-manual}" ;;
  stats)          do_stats ;;
  daemon|start)   do_daemon ;;
  stop)           do_daemon_stop ;;
  _discover)      discover_free_model ;;
  _loop)          do_daemon_loop ;;
  *)
    cat <<EOF
Usage: $0 <cmd>
  status           публичный IP, статус WARP SOCKS, OpenCode, пробный Zen
  on               WARP proxy-mode + поднять SOCKS + перезапустить OpenCode.app с ALL_PROXY
  off              выключить WARP + перезапустить OpenCode.app без прокси
  rotate [reason]  переподключить WARP (новый exit), OpenCode не трогается
  daemon           фоновый polling: при 429 на WARP exit автоматически ротирует
  stop             остановить фоновый polling
  stats            последние ротации и probe из SQLite ($DB)
EOF
    exit 1 ;;
esac
